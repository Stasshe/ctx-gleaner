{
  "name": "ctx-gleaner",
  "version": "0.3.0",
  "type": "module",
  "description": "Context-aware commit message generator for Claude Code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gle": "./bin/gle.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "biome lint src/**/*.ts tests/**/*.ts",
    "lint:fix": "biome check --write src/**/*.ts tests/**/*.ts",
    "format": "biome format --write src/**/*.ts tests/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "Stasshe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stasshe/ctx-gleaner"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "24.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
